{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enforce_auth_on_inference": true,
    "enable_logging": true,
    "disable_content_logging": true,
    "allow_per_request_content_storage_override": false,
    "log_retention_days": 90,
    "allowed_origins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ],
    "max_request_body_size_mb": 10
  },
  "providers": {
    "ollama": {
      "keys": [
        {
          "name": "ollama-local",
          "value": "",
          "models": [
            "gemma4:e4b",
            "qwen3.5:4b"
          ],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "http://ollama:11434"
          }
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 1,
        "allow_private_network": true
      }
    },
    "groq": {
      "keys": [
        {
          "name": "groq-free",
          "value": "env.GROQ_API_KEY",
          "models": [
            "qwen/qwen3.8-27b"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 60,
        "max_retries": 1
      }
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini-free",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "gemini-3.5-flash-lite"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 60,
        "max_retries": 1
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-privado",
        "name": "privado",
        "value": "env.VK_PRIVADO",
        "is_active": true,
        "disable_content_logging": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": [
              "gemma4:e4b",
              "qwen3.5:4b"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ],
        "rate_limit_id": "rl-privado"
      },
      {
        "id": "vk-geral",
        "name": "geral",
        "value": "env.VK_GERAL",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": [
              "gemma4:e4b",
              "qwen3.5:4b"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "groq",
            "allowed_models": [
              "qwen/qwen3.8-27b"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "gemini",
            "allowed_models": [
              "gemini-3.5-flash-lite"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ],
        "rate_limit_id": "rl-geral"
      },
      {
        "id": "vk-teste-orcamento",
        "name": "teste-orcamento",
        "value": "env.VK_TESTE_ORCAMENTO",
        "is_active": true,
        "disable_content_logging": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": [
              "gemma4:e4b",
              "qwen3.5:4b"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-teste-limite",
        "name": "teste-limite",
        "value": "env.VK_TESTE_LIMITE",
        "is_active": true,
        "disable_content_logging": true,
        "rate_limit_id": "rl-teste",
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": [
              "gemma4:e4b",
              "qwen3.5:4b"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "alias-local",
        "name": "Apelido 'local': gemma4 → qwen → Groq → Gemini (nuvem só para chaves que permitem)",
        "cel_expression": "model == 'local'",
        "priority": 10,
        "targets": [
          {
            "provider": "ollama",
            "model": "gemma4:e4b",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "ollama/qwen3.5:4b",
          "groq/qwen/qwen3.8-27b",
          "gemini/gemini-3.5-flash-lite"
        ]
      }
    ],
    "pricing_overrides": [
      {
        "id": "6b1f6e1a-0c1d-4c55-9a51-000000000001",
        "name": "Custo-sombra gemma4 = preço Claude Haiku 4.5",
        "scope_kind": "global",
        "match_type": "exact",
        "pattern": "gemma4:e4b",
        "request_types": [
          "chat_completion"
        ],
        "pricing_patch": "{\"input_cost_per_token\":0.000001,\"output_cost_per_token\":0.000005}"
      },
      {
        "id": "6b1f6e1a-0c1d-4c55-9a51-000000000002",
        "name": "Custo-sombra qwen3.5 = preço Claude Haiku 4.5",
        "scope_kind": "global",
        "match_type": "exact",
        "pattern": "qwen3.5:4b",
        "request_types": [
          "chat_completion"
        ],
        "pricing_patch": "{\"input_cost_per_token\":0.000001,\"output_cost_per_token\":0.000005}"
      }
    ],
    "budgets": [
      {
        "id": "budget-geral-mensal",
        "max_limit": 5.0,
        "reset_duration": "1M",
        "virtual_key_id": "vk-geral"
      },
      {
        "id": "budget-teste",
        "max_limit": 0.0005,
        "reset_duration": "1h",
        "virtual_key_id": "vk-teste-orcamento"
      }
    ],
    "rate_limits": [
      {
        "id": "rl-privado",
        "request_max_limit": 600,
        "request_reset_duration": "1h"
      },
      {
        "id": "rl-teste",
        "request_max_limit": 3,
        "request_reset_duration": "1m"
      },
      {
        "id": "rl-geral",
        "request_max_limit": 25,
        "request_reset_duration": "1m"
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/store/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/store/logs.db"
    }
  }
}
